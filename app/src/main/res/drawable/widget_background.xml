<?xml version="1.0" encoding="utf-8"?>
<!-- Fiend Glass Skeuomorphic Widget Background -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E61E1E28"
        android:centerColor="#D9161622"
        android:endColor="#F2101018"
        android:type="linear" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1.2dp"
        android:color="#35FFFFFF" />
</shape>
